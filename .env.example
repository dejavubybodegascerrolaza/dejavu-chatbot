# Bronze IQ — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.

# ── Supabase (required) ───────────────────────────────────────────────────────
# Find these in: Supabase Dashboard → Project → Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ── App configuration (optional) ─────────────────────────────────────────────
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_DISCLAIMER_VERSION=v1.0

# ── Observability (optional) ─────────────────────────────────────────────────
# When integrating Sentry: create a project at sentry.io, install
# @sentry/react-native, add the Expo plugin to app.config.ts, then set:
# EXPO_PUBLIC_SENTRY_DSN=https://your-key@sentry.io/your-project-id
# Leave unset or empty to disable error reporting (safe no-op).

# ── NEVER add here ────────────────────────────────────────────────────────────
# SUPABASE_SERVICE_ROLE_KEY  ← server-side only, never in the mobile client
