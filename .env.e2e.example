# Bronze IQ — Maestro E2E Test Credentials
#
# These are NOT app env vars — they are passed to maestro at runtime via -e flags.
# Copy this to .env.e2e and fill in your staging test account credentials.
# NEVER commit .env.e2e — it is listed in .gitignore.
#
# Usage (do NOT source this file — pass values explicitly):
#
#   maestro test .maestro/01-smoke-login-to-home.yaml \
#     -e BRONZE_IQ_TEST_EMAIL=e2e@bronzeiq.test \
#     -e BRONZE_IQ_TEST_PASSWORD=YourStagingPassword!
#
# The test account must:
#   - exist in the STAGING Supabase project (never production)
#   - have email confirmation disabled OR be pre-confirmed
#   - have onboarding_completed_at set in the profiles table
#
# See docs/qa/e2e-staging-setup.md for setup instructions.

BRONZE_IQ_TEST_EMAIL=e2e@your-staging-project.test
BRONZE_IQ_TEST_PASSWORD=change-me-staging-password
