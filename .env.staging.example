# Bronze IQ — Staging Environment Variables
# Copy this file to .env.staging and fill in your STAGING Supabase values.
# NEVER commit .env.staging to version control.
# NEVER point this at the production Supabase project.
#
# Purpose: isolated Supabase project used exclusively for automated E2E tests
# so that test accounts, throwaway data, and seeded state never touch production.
#
# See docs/qa/e2e-staging-setup.md for the full setup walkthrough.

# ── Supabase STAGING project (required) ──────────────────────────────────────
# Create a separate project at supabase.com and paste its values here.
# Find these in: Supabase Dashboard → Project → Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://your-staging-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-staging-anon-key-here

# ── App configuration ─────────────────────────────────────────────────────────
EXPO_PUBLIC_APP_ENV=staging
EXPO_PUBLIC_DISCLAIMER_VERSION=v1.0

# ── Observability (optional — disable for tests) ─────────────────────────────
# Leave unset to keep error reporting silent during test runs.
# EXPO_PUBLIC_SENTRY_DSN=

# ── NEVER add here ────────────────────────────────────────────────────────────
# SUPABASE_SERVICE_ROLE_KEY  ← server-side only, never in the mobile client
